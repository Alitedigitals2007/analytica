# --- Database (Neon) ---
# Use the pooled connection string from your Neon project dashboard
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI (interpretation only, never calculation) ---
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# --- Uploads ---
# Vercel Blob token (production). Leave empty in local dev to use ./storage/uploads
BLOB_READ_WRITE_TOKEN=
